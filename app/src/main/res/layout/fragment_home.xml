<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center"
    android:background="?android:attr/colorBackground">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Web Services Dashboard"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="?android:attr/textColorPrimary"
        android:layout_marginBottom="12dp"
        android:gravity="center" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Explore different HTTP request endpoints"
        android:textSize="15sp"
        android:textColor="?android:attr/textColorSecondary"
        android:layout_marginBottom="40dp"
        android:gravity="center" />

    <Button
        android:id="@+id/btn_fetch_users"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Fetch Users API"
        android:textSize="16sp"
        android:backgroundTint="#4F46E5"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btn_fetch_products"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Fetch Products API"
        android:textSize="16sp"
        android:backgroundTint="#1E293B" />

</LinearLayout>